# claudedot configuration
# Copy to ~/.config/claudedot/cdot.env and uncomment/customize the values you need.
# If $XDG_CONFIG_HOME is set, use $XDG_CONFIG_HOME/claudedot/cdot.env instead.
# This file is sourced as a shell script, so variable expansion works.
#
# All settings are optional — cdot works without this file using the defaults shown below.

# ─── paths ────────────────────────────────────────────────────────────────────

# Claude Code config directory to sync
# CDOT_CLAUDE_DIR="$HOME/.claude"

# opencode config file to sync alongside Claude config (default: ~/.config/opencode/opencode.json)
# Note: opencode.json may contain API keys — ensure your sync remote is private.
# CDOT_OPENCODE_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"

# ─── sync ─────────────────────────────────────────────────────────────────────

# Warn when total history size across opted-in projects exceeds this threshold (MB)
# CDOT_SYNC_SIZE_WARN_MB=500

# ─── companion tools ──────────────────────────────────────────────────────────

# claudebox — Claude Code container runtime
# Install: brew tap bpeterme/claudebox && brew install bpeterme/claudebox/claudebox
# Set up:  cbox build

# flux — large-file routing for your projects (git + R2 storage)
# Install: brew tap bpeterme/flux && brew install bpeterme/flux/flux
# Set up:  flux setup
