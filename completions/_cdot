#compdef cdot

# The candidates come from cdot itself (`cdot _complete`), so they always
# match its commands, and project names come from its own configuration —
# nothing from cdot.env lands in the interactive shell.
_cdot() {
  local IFS=$'\n'
  local -a candidates
  candidates=($(cdot _complete "${words[@]:1:$((CURRENT - 2))}" 2>/dev/null))
  compadd -a candidates
}

_cdot "$@"
